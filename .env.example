# Пример файла переменных окружения для production
# Скопируйте в .env и настройте под ваши нужды

# Spring профиль
SPRING_PROFILES_ACTIVE=integrated

# Redis настройки
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2000ms

# TTL настройки
TTL_REDIS=3600

# JVM настройки
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+UseContainerSupport

# Логирование
LOGGING_LEVEL_COM_EXAMPLE_CACHE=DEBUG
LOGGING_LEVEL_KG_SSM_SERVICE_REDIS=DEBUG

# Кеш настройки
CACHE_CAFFEINE_SPEC=maximumSize=1000,expireAfterWrite=5m,recordStats
CACHE_REDIS_DEFAULT_TTL=3600000
CACHE_REDIS_KEY_PREFIX=ClientAml

# Nginx настройки (если используется)
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# Мониторинг
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always